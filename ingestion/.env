# --- REDIS CONFIGURATION ---
# Points to your local Homebrew Redis instance
REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD= # Leave blank if running locally without auth

# --- API CREDENTIALS ---
# Get your free token from https://cryptopanic.com/developers/api/
CRYPTOPANIC_AUTH_TOKEN=your_cryptopanic_token_here

# --- LOCAL AI CONFIGURATION ---
# Default port for Ollama on Mac
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- BINANCE WEBSOCKET ---
# We use the testnet wss url for safety during development
# PRODUCTION URL
# BINANCE_WS_URL=wss://fstream.binance.com/ws. 

# TESTNET URL
BINANCE_WS_URL=wss://stream.binancefuture.com/ws